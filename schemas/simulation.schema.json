{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Simulation configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stepMs",
    "maxStepsPerAdvance",
    "maxQueuedCommands",
    "maxTransitionsPerStep",
    "maxCommandLeadMs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "stepMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maxStepsPerAdvance": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maxQueuedCommands": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maxTransitionsPerStep": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maxCommandLeadMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
